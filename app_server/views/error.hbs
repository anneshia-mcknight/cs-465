<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{title}}</title>
    <link rel="stylesheet" href="/css/style.css" type="text/css">
</head>
<body>
    <div id="background">
        <div id="page">
            {{> header }}
            <div id="contents">
                <div class="box">
                    <div>
                        <div class="body">
                            <h1>{{message}}</h1>
                            <p>{{error.status}}</p>
                            <pre>{{error.stack}}</pre>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {{> footer }}
    </div>
</body>
</html>
